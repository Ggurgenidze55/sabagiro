{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/artist-tickets",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/purge-tickets",
      "schedule": "0 22 * * *"
    }
  ]
}
