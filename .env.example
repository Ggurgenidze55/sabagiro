# PostgreSQL (Railway / Neon / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sabagiro"

# Session signing (min 16 chars) — openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (QR links + emails)
APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Email (Resend — tickets + contact form)
RESEND_API_KEY=""
EMAIL_FROM="Sabagiro <info@sabagiro.ge>"
# Contact form — comma-separated inboxes (both recommended)
# CONTACT_INBOX_EMAIL="info@sabagiro.ge,info.sabagiro@gmail.com"

# Vercel Cron — artist weekly tickets (Thu 20:00 Tbilisi). openssl rand -base64 32
CRON_SECRET=""

# Apple Wallet (.pkpass) — optional; see docs/WALLET.md
# APPLE_WALLET_PASS_TYPE_ID="pass.ge.sabagiro.ticket"
# APPLE_WALLET_TEAM_ID=""
# APPLE_WALLET_WWDR_CERT=""
# APPLE_WALLET_SIGNER_CERT=""
# APPLE_WALLET_SIGNER_KEY=""
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=""

# Google Wallet (Android) — optional; see docs/GOOGLE-WALLET.md
# GOOGLE_WALLET_ISSUER_ID=""
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
# GOOGLE_WALLET_REVIEW_STATUS="UNDER_REVIEW"

# Analytics & SEO — see docs/SEO.md
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345
# GOOGLE_SITE_VERIFICATION=google-site-verification-code

# First admin (run: npm run seed:admin — local only)
ADMIN_EMAIL="info@sabagiro.ge"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_PHONE="+995500000000"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="Sabagiro"
ADMIN_PERSONAL_ID="00000000000"

# Flitt payments (live) — Merchant portal → Merchant settings → Basic profile
# Without these, checkout uses the local test simulator.
# FLITT_MERCHANT_ID="your-merchant-id"
# FLITT_SECRET_KEY="your-payment-key"
# FLITT_API_ORIGIN="https://pay.flitt.com"
# SABAGIRO_PAYMENTS_TEST_MODE="false"
# Server callback (default): https://www.sabagiro.ge/api/webhooks/flitt

# Company legal (Flitt / card-scheme public pages)
# COMPANY_IDENTIFICATION_CODE="405XXXXXX"
# COMPANY_PHONE="+9955XXXXXXXX"
# COMPANY_LEGAL_ADDRESS="Leo Kvachadze St, Lisi, Saburtalo, Tbilisi 0176, Georgia"
